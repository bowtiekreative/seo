    {
      "id": "SOP-03",
      "number": 3,
      "name": "Cluster queries and assign canonical ownership",
      "goal": "",
      "sections": [
        {
          "heading": "Steps",
          "prose": [
            "1. Group same-sense lexical variants.",
            "2. identify the dominant task for each query.",
            "3. compare answer structure and result class.",
            "4. inspect current result overlap as supporting evidence.",
            "5. merge same-task queries.",
            "6. split different completion conditions.",
            "7. assign one intended canonical URL.",
            "8. map existing URLs to clusters.",
            "9. flag missing pages, duplicate owners, and uncertain boundaries.",
            "10. record exclusions and supporting questions."
          ],
          "bullets": [
            "Group same-sense lexical variants.",
            "identify the dominant task for each query.",
            "compare answer structure and result class.",
            "inspect current result overlap as supporting evidence.",
            "merge same-task queries.",
            "split different completion conditions.",
            "assign one intended canonical URL.",
            "map existing URLs to clusters.",
            "flag missing pages, duplicate owners, and uncertain boundaries.",
            "record exclusions and supporting questions."
          ],
          "blocks": [],
          "tables": []
        },
        {
          "heading": "Decision",
          "prose": [],
          "bullets": [],
          "blocks": [
            {
              "lang": "text",
              "code": "same sense\nAND same task\nAND compatible answer\nAND compatible next action\n→ same cluster\n\ndifferent task\nOR different sense\nOR different necessary format\n→ separate cluster"
            }
          ],
          "tables": []
        }
      ],
      "source": {
