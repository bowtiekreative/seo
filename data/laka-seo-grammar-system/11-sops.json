    {
      "id": "SOP-07",
      "number": 7,
      "name": "Resolve cannibalization",
      "goal": "",
      "sections": [
        {
          "heading": "Detection",
          "prose": [
            "Flag clusters with:"
          ],
          "bullets": [],
          "blocks": [
            {
              "lang": "text",
              "code": "multiple ranking URLs\nAND unstable dominant URL\nOR divided links\nOR wrong landing page\nOR lower conversion from the winning URL"
            }
          ],
          "tables": []
        },
        {
          "heading": "Options",
          "prose": [],
          "bullets": [],
          "blocks": [
            {
              "lang": "text",
              "code": "MERGE\nif task and answer substantially overlap.\n\nREPOSITION\nif the weaker page has a valid adjacent task.\n\nKEEP BOTH\nif tasks are distinct and behavior is healthy.\n\nRETIRE\nif the weak page has no value, dependencies, or equity."
            }
          ],
          "tables": []
        },
        {
          "heading": "Migration steps",
          "prose": [
            "1. choose canonical winner;",
            "2. combine unique useful information;",
            "3. preserve required evidence and media;",
            "4. redirect when the old URL should disappear;",
            "5. update internal links;",
            "6. update sitemap and canonical signals;",
            "7. observe impressions, dominant share, links, and value;",
            "8. rollback or refine if material loss occurs."
          ],
          "bullets": [
            "choose canonical winner;",
            "combine unique useful information;",
            "preserve required evidence and media;",
            "redirect when the old URL should disappear;",
            "update internal links;",
            "update sitemap and canonical signals;",
            "observe impressions, dominant share, links, and value;",
            "rollback or refine if material loss occurs."
          ],
          "blocks": [],
          "tables": []
        }
      ],
      "source": {
        "document": "06",
        "file": "06-AUDIT-AND-EXECUTION-SOPS.md",
        "heading": "SOP 7 — Resolve cannibalization"
      }
