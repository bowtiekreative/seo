    {
      "id": "SOP-04",
      "number": 4,
      "name": "Find high-value existing opportunities",
      "goal": "",
      "sections": [
        {
          "heading": "Steps",
          "prose": [
            "1. Export query-page data.",
            "2. join business value and conversion data.",
            "3. calculate cluster-level impressions, clicks, CTR residual, and value.",
            "4. identify positions or visibility below potential.",
            "5. identify pages with links/authority but weak intent alignment.",
            "6. identify ranking pages with poor conversion.",
            "7. identify converting pages with low visibility.",
            "8. identify high-value pages with technical eligibility problems.",
            "9. score opportunities by incremental value per effort.",
            "10. select a bounded treatment portfolio."
          ],
          "bullets": [
            "Export query-page data.",
            "join business value and conversion data.",
            "calculate cluster-level impressions, clicks, CTR residual, and value.",
            "identify positions or visibility below potential.",
            "identify pages with links/authority but weak intent alignment.",
            "identify ranking pages with poor conversion.",
            "identify converting pages with low visibility.",
            "identify high-value pages with technical eligibility problems.",
            "score opportunities by incremental value per effort.",
            "select a bounded treatment portfolio."
          ],
          "blocks": [],
          "tables": []
        },
        {
          "heading": "Priority logic",
          "prose": [],
          "bullets": [],
          "blocks": [
            {
              "lang": "text",
              "code": "measurement block\n> eligibility block\n> canonical conflict\n> existing high-value response gap\n> content/format gap\n> authority gap\n> new asset"
            }
          ],
          "tables": []
        }
      ],
      "source": {
