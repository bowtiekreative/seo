  "cluster_gate_note": "These decide whether two candidates share one canonical page. They are not publication gates.",
  "one_page_rule": [
    "IF same sense",
    "AND same task",
    "AND compatible answer structure",
    "AND compatible result class",
    "AND compatible next action",
    "THEN same cluster and one canonical owner",
    "ELSE split or test."
  ],
