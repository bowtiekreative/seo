  "gate_note": "All eight must pass. A candidate that fails any one routes to research, consolidation, repair, deferral or rejection — never to publication.",
  "cluster_gates": [
    {
      "id": "merge",
      "name": "Merge gate",
      "qualifier": null,
      "joiner": "AND",
      "conditions": [
        "IF sense_match = true",
        "task_match = true",
        "answer_structure_compatible = true",
        "next_action_compatible = true",
        "separate_page_value = low",
        "THEN assign to same cluster"
      ],
      "source": {
        "document": "03",
        "file": "03-VOLUMETRIC-SEO-ENGINE.md",
        "heading": "Merge gate"
      }
    },
    {
      "id": "split",
      "name": "Split gate",
      "qualifier": null,
      "joiner": "OR",
      "conditions": [
        "IF sense differs",
        "task differs",
        "result class differs",
        "local/product inventory differs",
        "legal context differs",
        "combined answer harms usability",
        "THEN create separate cluster candidate"
      ],
      "source": {
        "document": "03",
        "file": "03-VOLUMETRIC-SEO-ENGINE.md",
        "heading": "Split gate"
      }
    },
    {
      "id": "test",
      "name": "Test gate",
      "qualifier": null,
      "joiner": "AND",
      "conditions": [
        "IF evidence is ambiguous",
        "THEN:",
        "keep one provisional cluster",
        "observe query/page behavior",
        "run a controlled asset-format test",
        "BEFORE multiplying pages"
      ],
      "source": {
        "document": "03",
        "file": "03-VOLUMETRIC-SEO-ENGINE.md",
        "heading": "Test gate"
